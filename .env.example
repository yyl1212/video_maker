# 相对路径始终以仓库根目录为基准；数据库及媒体不进入Git。
VM_DATA_DIR=./data
# 启动脚本使用固定8000/3000端口；前端rewrite地址在构建时确定。
VM_BACKEND_URL=http://127.0.0.1:8000
# 可选：本机浏览器允许的来源，须使用JSON数组。
# VM_FRONTEND_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000","http://127.0.0.1:8000","http://localhost:8000"]
# 文本、Draw Things和H3模型连接与参数通过页面保存到本机数据库。
